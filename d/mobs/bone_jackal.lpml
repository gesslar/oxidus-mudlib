// d/mobs/bone_jackal.lpml
// The apex scavenger of the wastes, denning among the skeletal remains it
// picks clean.

{
  type: "mammal",
  name: "bone jackal",
  short: "a bone jackal",
  long: "A rangy jackal with a coat gone the colour of old bone, dusty and"
