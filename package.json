{
  "scripts": {
    "wiki": "docker compose -f adm/etc/starlight/docker-compose.yml up -d",
    "wiki:stop": "docker compose -f adm/etc/starlight/docker-compose.yml down",
    "wiki:dev": "npm --prefix doc/wiki run dev",
    "wiki:build": "npm --prefix doc/wiki run build",
    "wiki:deploy": "gh workflow run deploy-wiki.yml",
    "docker:deploy": "gh workflow run docker-publish.yml",
    "sefuns": "bash adm/bash/sefuns",
    "rebuild": "bash adm/dist/rebuild",
    "oxidus": "bash adm/dist/run bg",
    "stop": "bash adm/dist/run stop"
  },
  "devDependencies": {
    "@gesslar/bedoc": "*",
    "@gesslar/lpc-mcp": "^1.6.1"
  }
}
