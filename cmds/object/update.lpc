/**
 * @file /cmds/object/update.lpc
 *
 * A command to update objects! Neat, huh?
 *
 * @created 2026-07-13 - Gesslar
 * @last_modified 2026-08-30 - Gesslar
 *
 * @history
 * 2026-07-13 - Gesslar - Created
 * 2026-08-30 - Gesslar - Added smart updating (-s)
 */

#include <stat.h>

inherit STD_CMD;

void setup() {
  usage_text =
    "update [<file|object>]\n"
    "update -s [<file|object>]\n"
    "update -r [<file|object>]\n"
    "update -R [<file|object>]\n"
  ;

  help_text =
    "Reloads an object from source, putting any players who were inside it "
    "back afterwards. The target may be a file path or something you can "
    "name in your inventory or the room; with no target at all, your current "
    "working file is used, which is whatever you updated last.\n"
    "\n"
    "'-r' also reloads the object's immediate inheritables, and '-R' walks "
    "the whole inheritance tree beneath it. Virtual objects are reloaded "
    "through their virtual master.\n"
    "\n"
    "'-s' is the smart form of '-R': it walks the same tree but reloads only "
    "the files that have actually moved on since the object was loaded — "
    "those whose source has been edited, and those that have been updated "
    "out from under it, along with anything that inherits one of those. The "
    "object itself is always reloaded.\n"
    "\n"
    "This command cannot update itself — destruct it instead and it will "
    "reload on next use.\n"
    "\n"
    "See also: dest, showtree\n";
}

private nomask mapping resolve_target(mixed target, string kind);
private nomask void generate_graph(mapping target, string kind);
private nomask void prune_graph(mapping target);
private nomask int reference_time(mapping target);
private nomask int newer_than(string file, int since);
private nomask int inherits_newer(string file, mapping newer);
private nomask mixed reload_it(mixed target);
private nomask mixed perform_update(object tp, mapping target);

mixed main(
  /** @type {STD_PLAYER} */ object tp,
  string arg
) {
  string target;
  mapping to_update;

  if(!arg)
    to_update = resolve_target(tp->query_env("cwf"), "single");
  else if(arg == "-r")
    to_update = resolve_target(tp->query_env("cwf"), "shallow");
  else if(sscanf(arg, "-r %s", target) == 1)
    to_update = resolve_target(target, "shallow");
  else if(arg == "-R")
    to_update = resolve_target(tp->query_env("cwf"), "deep");
  else if(sscanf(arg, "-R %s", target) == 1)
    to_update = resolve_target(target, "deep");
  else if(arg == "-s")
    to_update = resolve_target(tp->query_env("cwf"), "smart");
  else if(sscanf(arg, "-s %s", target) == 1)
    to_update = resolve_target(target, "smart");
  else
    to_update = resolve_target(arg, "single");

  if(!to_update) {
    if(!tp->query_env("cwf"))
      return _error(tp, "You do not have a current working file.");
    else
      return _error(tp, "Invalid target for update.");
  }

  if(includes(to_update.graph, base_name()))
    return _error("The update command may not be updated in this manner. "
                  "Destruct it instead.");

  tp->set_env("cwf", to_update.file);

  return perform_update(tp, to_update);
}

private nomask mapping resolve_target(mixed target, string kind) {
  if(stringp(target)) {
    if(cfile_exists(target)) {
      if(find_object(target)) {
        return resolve_target(find_object(target), kind);
      }
    }

    return resolve_target(get_object(target), kind);
  }

  if(!objectp(target))
    return 0;

  mapping new_target = ([
    "file": base_name(target),
    "object": target,
    "virtual": false,
    "virtual_master": undefined,
  ]);

  if(virtualp(target)) {
    new_target["virtual"] = true;
    new_target["virtual_master"] =
      /** @type {STD_OBJECT} */ (target)->query_virtual_master();
  }

  generate_graph(new_target, kind);

  return new_target;
}

private nomask void process_leaf(object ob, mixed ref *graph, int recurse: (: 0 :)) {
  string *list = inherit_list(ob);

  if(!sizeof(list))
    return;

  if(recurse) {
    foreach(string file in list) {
      object sub_ob = load_object(file);
      process_leaf(sub_ob, ref graph, recurse);
    }
  }

  push(ref graph, list);
}

private nomask void generate_graph(mapping target, string kind) {
  target["graph"] = ({});

  if(kind != "single") {
    if(kind == "shallow")
      process_leaf(target["object"], ref target["graph"], 0);
    if(kind == "deep" || kind == "smart")
      process_leaf(target["object"], ref target["graph"], 1);
  }

  if(target.virtual)
    push(ref target["graph"], ({target.virtual_master}));
  else
    push(ref target["graph"], ({target.file}));

  target["graph"] = uniq_array(flatten(target["graph"]));

  if(kind == "smart")
    prune_graph(target);
}

/**
 * Reduces a target's graph to the files that have moved on since the target
 * was loaded, plus everything that inherits one of them, keeping the target
 * itself in every case. Records the number of entries dropped in the target's
 * "pruned" key.
 *
 * If the reference time cannot be established the graph is left alone, so a
 * smart update degrades to a full deep update rather than skipping work it
 * cannot reason about.
 *
 * @param {mapping} target - A target mapping whose graph has been generated
 */
private nomask void prune_graph(mapping target) {
  int since = reference_time(target);

  if(!since)
    return;

  string anchor = target.virtual ? target.virtual_master : target.file;
  mapping newer = ([]);
  string *pruned = ({});

  foreach(string file in target["graph"]) {
    if(file != anchor && !newer_than(file, since) && !inherits_newer(file, newer))
      continue;

    newer[source_file(file)] = 1;
    pruned += ({ file });
  }

  target["pruned"] = sizeof(target["graph"]) - sizeof(pruned);
  target["graph"] = pruned;
}

/**
 * Reports whether any of a file's immediate inheritables has already been
 * marked newer. A file that inherits something newer must be recompiled too,
 * because its program has the old copy of that inheritable baked into it.
 *
 * The graph is walked deepest-first, so every inheritable of a file has
 * already been decided by the time the file itself is reached — checking the
 * immediate list is enough to carry the whole chain upwards.
 *
 * @param {string} file - A file from the target's graph
 * @param {mapping} newer - Source paths marked newer so far, as a set
 * @returns {int} 1 if the file inherits something newer, otherwise 0
 */
private nomask int inherits_newer(string file, mapping newer) {
  object ob = find_object(file);

  if(!objectp(ob))
    return 0;

  foreach(string parent in inherit_list(ob))
    if(newer[source_file(parent)])
      return 1;

  return 0;
}

/**
 * Returns the time the target's own program was last loaded, which is the
 * reference the rest of the graph is measured against. Anything that has
 * changed on disk or been reloaded since then is newer than what the target
 * is currently running against.
 *
 * @param {mapping} target - A target mapping from resolve_target()
 * @returns {int} The target's load time, or 0 if it cannot be determined
 */
private nomask int reference_time(mapping target) {
  string file = target.virtual ? target.virtual_master : target.file;
  mixed *info = stat(source_file(file));

  if(!pointerp(info) || sizeof(info) != 4)
    return 0;

  if(!intp(info[STAT_TIME_OBJECT_LOADED]))
    return 0;

  return info[STAT_TIME_OBJECT_LOADED];
}

/**
 * Reports whether a file in the graph is newer than a reference time, either
 * because its source has been edited since or because its program has been
 * reloaded since. A file whose source cannot be stat'd counts as newer, so
 * that nothing is silently skipped.
 *
 * @param {string} file - A file from the target's graph
 * @param {int} since - The reference time to measure against
 * @returns {int} 1 if the file is newer than since, otherwise 0
 */
private nomask int newer_than(string file, int since) {
  mixed *info = stat(source_file(file));

  if(!pointerp(info) || sizeof(info) != 4)
    return 1;

  if(!intp(info[STAT_LAST_MODIFIED]))
    return 1;

  return info[STAT_LAST_MODIFIED] > since ||
         info[STAT_TIME_OBJECT_LOADED] > since;
}

private nomask mixed reload_it(mixed target) {
  /** @type {STD_OBJECT} */ object ob = find_object(target);
  /** @type {STD_PLAYER*} */ object *livs = present_players(ob);

  if(objectp(ob))
    catch(ob->remove());
  else
    return;

  if(ob)
    destruct(ob);

  string err = catch(ob = load_object(target));
  if(err)
    return err;

  if(sizeof(livs))
    livs->move(ob);
}

private nomask mixed perform_update(object tp, mapping target) {
  if(target["pruned"])
    _info(tp, "Skipping %d unchanged %s in the graph.", target["pruned"],
          target["pruned"] == 1 ? "file" : "files");

  foreach(string file in target.graph) {
    string err = reload_it(file);
    if(err) {
      if(target.virtual) {
        return _error("Unable to update %O (%O):\n%s => %s", target.file, target.virtual_master, file, err);
      } else {
        return _error("Unable to update %O:\n%s => %s", target.file, file, err);
      }
    }

    _ok(tp, "%s => OK", file);
  }

  if(target.virtual && objectp(target["object"])) {
    if(roomp(target["object"])) {
      reload_it(file_name(target["object"]));
    }
  }

  return 1;
}
