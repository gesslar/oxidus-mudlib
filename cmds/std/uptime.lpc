/**
 * @file /cmds/std/uptime.lpc
 *
 * Display how long the MUD has been running.
 *
 * @created 2005-04-08 - Tacitus @ LPUniversity
 * @last_modified 2026-07-13 - Gesslar
 *
 * @history
 * 2005-04-08 - Tacitus - Created
 * 2005-10-20 - Tacitus - Last edited
 * 2026-07-13 - Gesslar - Moved help into setup()
 */

inherit STD_CMD;

void setup() {
  usage_text = "uptime";
  help_text =
"This command will tell you how long the mud has been running.";
}

mixed main(object tp, string _arg) {
  tell_me(mud_name() + " has been running since " +
    ctime(time() - uptime()) + "\n");
  return 1;
}
