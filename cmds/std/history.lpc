/**
 * @file /cmds/std/history.lpc
 *
 * Command implementation for viewing a player's command history.
 * Allows viewing full history or specific ranges of past commands.
 *
 * @created 2006-08-12 - Tacitus
 * @last_modified 2026-07-13 - Gesslar
 *
 * @history
 * 2006-08-12 - Tacitus - Created
 * 2026-07-13 - Gesslar - Moved help into setup()
 */

inherit STD_CMD;

void setup() {
  usage_text = "history [range]";
  help_text =
"This command allows you to view the history of commands that you've executed. "
"By default it displays the last 15 commands executed by you but you may provide "
"a custom amount by providing an argument of 'all' to view the entire history or "
"a number of your choice.";
}

mixed main(object caller, string args) {
  int range, i;
  string *history = ({});

  history = caller->query_command_history();

  if(stringp(args)) {
    if(args == "all") {
      for(i = 0; i < sizeof(history); i++)
        printf(" %-5d %-5s %s\n", i, ":",  history[i]);
    } else {
      range = to_int(args);
      if(!intp(range) || range < 0)
        return _error("Invalid argument type.");
      else
        for(i = sizeof(history) - (range + 1); i < sizeof(history); i++)
          printf(" %-5d %-5s %s\n", i, ":",  history[i]);
    }
  } else {
    for(sizeof(history) > 16 ? i = sizeof(history) - 16 : i = 0; i < sizeof(history); i++)
      printf(" %-5d %-5s %s\n", i, ":",  history[i]);
  }

  return 1;
}
