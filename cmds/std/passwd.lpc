/**
 * @file /cmds/std/passwd.lpc
 *
 * Command to manage your own password or the password of another
 * user.
 *
 * @created 2024-07-14 - Gesslar
 * @last_modified 2026-07-13 - Gesslar
 *
 * @history
 * 2024-07-14 - Gesslar - Created
 * 2026-07-13 - Gesslar - Moved help into setup()
 */

inherit STD_CMD;

private void password_confirmed(int status, object tp);
private void new_password(string str, object tp);
private void confirm_password(string str, string pass, object tp);

void setup() {
  usage_text = "passwd";

  help_text =
    "This command allows you to change your current passwd. You will be asked "
    "to enter your current passwd for security purposes and then it will "
    "request you to input your new passwd and then will ask again to confirm. "
    "After you have provided the requested information, the command will "
    "inform you if the change was succesful.";
}

mixed main(object tp, string _arg) {
  _info("Changing your password.");
  prompt_password(tp, 3, assemble_call_back((:password_confirmed:), tp));

  return 1;
}

private void password_confirmed(int status, object tp) {
  if(status) {
    _question("Please enter your new password: ");
    input_to((:new_password:), I_NOECHO | I_NOESC, tp);
  } else {
    _error("Password change failed.");
  }
}

private void new_password(string str, object tp) {
  if(falsy(str)) {
    _error("Password cannot be empty.");
    return;
  }

  _question("Please confirm your new password: ");
  input_to((:confirm_password:), I_NOECHO | I_NOESC, str, tp);
}

/**
 * Confirms the re-entered password and writes it to the player's account.
 *
 * The password lives on the account, not the character, so the character
 * name has to be resolved to its account before the write.
 *
 * @param {string} str - The re-entered password.
 * @param {string} pass - The password being confirmed against.
 * @param {STD_PLAYER} tp - The player changing their password.
 */
private void confirm_password(string str, string pass, object tp) {
  string account;

  if(str != pass) {
    _error("Those passwords do not match.");
    return;
  }

  account = ACCOUNT_D->character_account(tp->query_real_name());

  if(!account) {
    _error("Could not find the account for your character.");
    _info("Please contact an admin for assistance.");
    return;
  }

  if(!ACCOUNT_D->write_account(account, "password", crypt(str, 0))) {
    _error("Your password could not be changed.");
    return;
  }

  _ok("Password changed.");
}
