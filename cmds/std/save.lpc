/**
 * @file /cmds/std/save.lpc
 *
 * A simple save command to persist player data.
 *
 * @created 2005-06-30 - Gwegster @ LPUniversity
 * @last_modified 2026-07-13 - Gesslar
 *
 * @history
 * 2005-06-30 - Gwegster - Created
 * 2005-10-08 - Tacitus - Last edited
 * 2026-07-13 - Gesslar - Moved help into setup()
 */

inherit STD_CMD;

void setup() {
  usage_text = "save";

  help_text =
"This command will save your character data.\n"
"\n"
"See also: quit";
}

mixed main(
  /** @type {STD_BODY} */ object caller,
  string _args
) {
  if(caller->save_body())
    return _ok("Saved.");

  return _warn("Unable to save.");
}
