/**
 * @file /cmds/std/date.lpc
 *
 * Display the current date.
 *
 * @created 2005-11-10 - Tacitus @ LPUniversity
 * @last_modified 2026-07-13 - Gesslar
 *
 * @history
 * 2005-11-10 - Tacitus - Created
 * 2026-07-13 - Gesslar - Moved help into setup()
 */

inherit STD_CMD;

void setup() {
  usage_text = "date";
  help_text =
"This command will return the current date. It is important to note though that "
"the date is in mud time, not in your localtime.";
}

mixed main(object tp, string _str) {
  tell(tp, sprintf(" The current date is %s.\n",
    ctime(time())));
  return 1;
}
