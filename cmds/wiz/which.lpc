/**
 * @file /cmds/wiz/which.lpc
 *
 * Locates which file or verb a given command resolves to.
 *
 * @created 2006-10-05 - Tacitus
 * @last_modified 2026-07-13 - Gesslar
 *
 * @history
 * 2006-10-05 - Tacitus - Created
 * 2026-07-13 - Gesslar - Added help text and LPCDoc header
 */

inherit STD_CMD;

void setup() {
  usage_text = "which <verb>";
  help_text = "Locates where a command would be found. It searches each "
    "directory in your command path for a matching command file, checks the "
    "local verbs added to your environment via add_action, and checks the "
    "exits of your current room. Every match is reported, so a verb defined "
    "in more than one place will show all of its locations.\n\n"
    "See also: path";
}

mixed main(
  /** @type {STD_PLAYER} */ object caller,
  string args
) {
  string *command_path = caller->get_path();
  mixed *actions = previous_object()->query_commands();
  int i, is_located = 0;

  if(!args)
    return _error("Syntax: which <verb/command>");

  for(i = 0; i < sizeof(command_path); i++) {
    if(file_exists(command_path[i] + args + ".lpc")) {
      is_located = 1;
      tell_me(command_path[i] + args + "\n");
    }
  }

  for(i = 0; i < sizeof(actions); i++) {
    if(actions[i][0] == args) {
      is_located = 1;
      tell_me("Local:  " + actions[i][2] + "\n");
    }
  }

  if(/** @type {STD_ROOM} */ (environment(previous_object()))->valid_exit(args)) {
    is_located = 1;
    tell_me(
      "Local Exit: " + /** @type {STD_ROOM} */ (environment(this_body()))->query_exit(args) + "\n"
    );
  }

  if(!is_located) {
    return _error("Error: '" + args + "' not found in " +
      simple_list(command_path) + " nor via a local " "add_action, or exit.\n"
    );
  }

  return 1;
}