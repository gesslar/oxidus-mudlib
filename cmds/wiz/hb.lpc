// /cmds/wiz/hb.c
// Determine all heartbeats or the heartbeat of a specific object
//
// Created:     2024/02/18: Gesslar
// Last Change: 2024/02/18: Gesslar
//
// 2024/02/18: Gesslar - Created

inherit STD_CMD;

mixed all_heartbeats();

mixed main(object _tp, string arg) {
  if(!arg)
    return "Usage: hb <object|all>";


  if(arg == "all")
    return all_heartbeats();


  /** @type {STD_ITEM} */ object ob;
  if(!ob = get_object(arg)) {
    string file = resolve_path("cwd", arg);
    file = append(file, ".lpc");

    if(file_exists(file)) {
      ob = load_object(file);
    }
  }

  if(!ob) {
    return "No such object: " + arg;
  }

  int i = query_heart_beat(ob);
  int hb_ms = (int)get_config(__RC_HEARTBEAT_INTERVAL_MSEC__);

  arg = ob->query_name();

  if(i) {
    return `Heartbeat is on for ${arg} (${i}x${hb_ms}ms = ${(i * hb_ms)}ms)`;
  } else {
    return `Heartbeat is off for ${arg}.`;
  }
}

mixed all_heartbeats() {
  int hb_ms = (int)get_config(__RC_HEARTBEAT_INTERVAL_MSEC__);

  object *obs = heart_beats();
  obs = filter(obs, (: living($1) && interactive($1) :));

  string *ret = ({ });
  for(int i = 0, sz = sizeof(obs); i < sz; i++) {
    int interval = query_heart_beat(obs[i]);

    if(query_heart_beat(obs[i])) {
      ret += ({
        `${obs[i]->query_name()} (${interval}x${hb_ms}ms = ${(interval * hb_ms)}ms)`
      });
    }
  }

  if(sizeof(ret)) {
    return ({ "All Heartbeats:", "" }) + map(ret, (: `  ${$1}` :));
  } else {
    return "No heartbeats.";
  }
}
