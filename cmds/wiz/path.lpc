/**
 * @file /cmds/wiz/path.lpc
 *
 * Shows or modifies the command search path.
 *
 * @created 2005-04-07 - Tacitus
 * @last_modified 2026-07-13 - Gesslar
 *
 * @history
 * 2005-04-07 - Tacitus - Created
 * 2026-07-13 - Gesslar - Added help text and LPCDoc header
 */

inherit STD_CMD;

void setup() {
  usage_text = "path\n"
    "path -add <directory>\n"
    "path -remove <directory>";
  help_text = "Shows or modifies the list of directories the mud searches to "
    "resolve the commands you type. With no arguments, it prints your current "
    "path. Use -add <directory> to append a directory to your path and "
    "-remove <directory> to drop one. Take care when removing directories: "
    "removing an important one (such as the directory containing this command) "
    "can leave you unable to run commands.";
}

mixed main(object caller, string str) {
  string action, arg, *path, ret;
  int i;

  ret = "";

  if(!str || !sscanf(str, "-%s %s", action, arg)) {
    path = this_body()->get_path();
    for(i = 0; i < sizeof(path); i++) {
      ret += path[i][0..<2] + ":";
    }

    tell_me("Current path: " + ret[0..<2] + "\n");
    return 1;
  }

  if(arg[<1..< 1] != "/") {
    arg += "/";
  }

  switch(action) {
    case "add" :
      this_body()->add_path(arg);
      break;

    case "remove" :
      this_body()->rem_path(arg);
      break;

    default :
      tell_me("Syntax: path [-add || -remove <path>]\n");
      break;
  }

  path = this_body()->get_path();

  for(i = 0; i < sizeof(path); i++) {
    ret += path[i][0..<2] + ":";
  }

  tell_me("New path: " + ret[0..<2] + "\n");

  return 1;
}