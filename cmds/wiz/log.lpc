/**
 * @file /cmds/wiz/log.lpc
 *
 * Displays the tail of a log file.
 *
 * @created 2006-07-14 - Gwegster
 * @last_modified 2026-07-13 - Gesslar
 *
 * @history
 * 2006-07-14 - Gwegster - Created
 * 2006-07-14 - Tacitus - Updated
 * 2026-07-13 - Gesslar - Added help text and LPCDoc header
 */

inherit STD_CMD;

void setup() {
  usage_text = "log\n"
    "log <logfile>";
  help_text = "Displays the tail (the ending) of a log file. With no "
    "argument it shows the 'log' file in your home directory if one exists, "
    "otherwise it falls back to the driver compile log. Given an argument it "
    "shows the tail of /log/<logfile>, including files in subdirectories of "
    "/log/ (for example 'log driver/UPRECORD'). The number of lines shown is "
    "controlled by your 'morelines' preference.";
}

mixed main(/** @type {STD_PLAYER} */ object caller, string arg) {
  string logfile;
  int morelines;
  string *out;

  if(!arg) {
    if(file_exists(log_dir() + "compile")) {
      logfile = log_dir() + "compile";
    }
    if(file_exists(home_path(query_privs(this_body())) + "log")) {
      logfile = home_path(query_privs(this_body())) + "log";
    }
  } else {
    if(file_exists(log_dir() + arg)) {
      logfile = log_dir() + arg;
    } else {
      return notify_fail("Error [log]: Logfile '/log/" + arg +"' doesn't exist.\n");
    }
  }

  if(!logfile) {
    return notify_fail("Syntax: log <logfile>\n");
  }

  if(!caller->query_pref("morelines")) {
    caller->set_pref("morelines", "20");
  }

  morelines = to_int(caller->query_pref("morelines"));
  out = explode(tail(logfile, morelines-2), "\n");
  out = ({ logfile + ":" }) + out;

  return out;
}