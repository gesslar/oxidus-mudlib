/**
 * @file /cmds/wiz/sockinfo.lpc
 *
 * Displays the driver's current socket status.
 *
 * @created 2006-05-05 - Tacitus
 * @last_modified 2026-07-13 - Gesslar
 *
 * @history
 * 2006-05-05 - Tacitus - Created
 * 2026-07-13 - Gesslar - Added help text and LPCDoc header
 */

inherit STD_CMD;

void setup() {
  usage_text = "sockinfo";
  help_text = "Dumps the driver's socket status. This shows every socket "
    "currently loaded along with what each one is presently being used for.";
}

mixed main(object tp, string str) {
  tell_me(dump_socket_status());
  return 1;
}