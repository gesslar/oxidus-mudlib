/**
 * @file /cmds/adm/wall.lpc
 *
 * Admin command that pages a system-wide message to every connected
 * user, stamped with the sender's name and the current time.
 *
 * @created 2005-07-01 - Tacitus @ LPUniversity
 * @last_modified 2026-07-13 - Gesslar
 *
 * @history
 * 2005-07-01 - Tacitus - Created
 * 2026-07-13 - Gesslar - Moved help into setup()
 */

inherit STD_CMD;

void setup() {
  usage_text = "wall <msg>";
  help_text =
    "This command pages a message to everybody on the MUD. The message is "
    "prefixed with your name and the current time and delivered to every "
    "connected user.";
}

mixed main(/** @type {STD_PLAYER} */ object caller, string str) {
  object *all_users;

  if(!adminp(previous_object()))
    return _error("Error [wall]: Access denied.");

  if(!stringp(str)) {
    _error("You must supply an argument. Syntax: wall <msg>");
    return 1;
  }

  all_users = users();

  foreach(object user in all_users) {
    tell(user, "**** System Wide Message From: "
      + capitalize(caller->query_real_name()) + " at "
      + ctime(time()) + " ****\n\n\t" + str + "\n");
  }

  return 1;
}
