/**
 * @file /cmds/adm/reboot.lpc
 *
 * Admin command that schedules, queries, or cancels a reboot of the
 * mud via the shutdown daemon. The mud shuts down and comes back up.
 *
 * @created 2005-07-01 - Tacitus @ LPUniversity
 * @last_modified 2026-07-13 - Gesslar
 *
 * @history
 * 2005-07-01 - Tacitus - Created
 * 2005-10-22 - Tacitus - Recoded
 * 2026-07-13 - Gesslar - Moved help into setup()
 */

#include <logs.h>
#include <shutdown.h>

inherit STD_CMD;

void setup() {
  usage_text = "reboot [<stop>||<time>/now]";
  help_text =
    "This command starts a reboot of the mud. Supply the number of minutes "
    "until the reboot should occur, or 'now' to reboot as soon as the command "
    "is given. Supply 'stop' to cancel a shutdown or reboot already in "
    "progress. With no argument, the current shutdown/reboot status is "
    "reported.\n"
    "\n"
    "Note that this reboots the mud and brings it back up. If you want the mud "
    "to stay down afterwards, use the shutdown command instead.\n"
    "\n"
    "See also: shutdown";
}

mixed main(/** @type {STD_PLAYER} */ object caller, string arg) {
  string status;
  int delay;

  status = shutdown_d()->get_status();

  if(!adminp(previous_object()))
    return _error("Access denied.");

  if(!arg) {
    if(status)
      _info("Shutdown: " + status);
    else
      _info("There is no shutdown or reboot "
        "currently in progress.");
    return 1;
  }

  if(arg == "stop") {
    if(!status)
      return _error("There is no shutdown or reboot "
        "currently in progress.");

    shutdown_d()->stop();
    log_file(LOG_SHUTDOWN,
      capitalize(caller->query_real_name()) +
      " canceled the sequence (" + delay + "m) on " +
      ctime(time()) + "\n");
    return 1;
  } else {
    if(arg == "now")
      delay = 0;
    else
      delay = to_int(arg);

    if(delay == 0 && arg != "now" && arg != "0")
      return _error("SYNTAX: reboot [<stop>||<time>/now]");

    log_file(LOG_SHUTDOWN,
      capitalize(caller->query_real_name()) +
      " started reboot sequence (" + delay + "m) on " +
      ctime(time()) + "\n");
    shutdown_d()->start(delay, SYS_REBOOT);
    return 1;
  }
}
