/**
 * @file /cmds/adm/shutdown.lpc
 *
 * Admin command to start or cancel a shutdown of the mud.
 *
 * @created 2005-07-01 - Tacitus
 * @last_modified 2026-07-13 - Gesslar
 *
 * @history
 * 2005-07-01 - Tacitus - Created
 * 2026-07-13 - Gesslar - Moved help into setup()
 */

#include <logs.h>
#include <shutdown.h>

inherit STD_CMD;

void setup() {
  usage_text = "shutdown [<stop>||<time>/now]";
  help_text =
"This command starts a shutdown of the mud. You can either supply the "
"amount of time until the shutdown is to occur, or stop the current "
"shutdown/reboot by giving the argument stop. You may also give the "
"argument now to shut the mud down as soon as the command is given.\n\n"
"Remember that this command shuts the mud down and it will not come "
"back up on its own. If you wish for the mud to restart afterwards, "
"look at the reboot command.\n\n"
"See also: reboot";
}

mixed main(/** @type {STD_PLAYER} */ object caller, string arg) {
  string status;
  int delay;

  status = shutdown_d()->get_status();

  if(!adminp(previous_object()))
    return _error("Access denied.");

  if(!arg) {
    if(status)
      _info("Shutdown: " + status);
    else
      _info("There is no shutdown or reboot "
        "currently in progress.");
    return 1;
  }

  if(arg == "stop") {
    if(!status)
      return _error("There is no shutdown or reboot "
        "currently in progress.");

    shutdown_d()->stop();
    log_file(LOG_SHUTDOWN,
      capitalize(caller->query_real_name()) +
      " canceled the sequence (" + delay + "m) on " +
      ctime(time()) + "\n");
    return 1;
  } else {
    if(arg == "now")
      delay = 0;
    else
      delay = to_int(arg);

    if(delay == 0 && arg != "now" && arg != "0")
      return _error("SYNTAX: shutdown [<stop>||<time>/now]");

    log_file(LOG_SHUTDOWN,
      capitalize(caller->query_real_name()) +
      " started shutdown sequence (" + delay + "m) on " +
      ctime(time()) + "\n");
    shutdown_d()->start(delay, SYS_SHUTDOWN);
    return 1;
  }
}
