// @lpc-nocheck
/**
 * @file /tests/adm/simul_efun/array.async.test.lpc
 *
 * Tests for each_async() in /adm/simul_efun/array.lpc.
 *
 * Two kinds of test here. The test() entries assert what each_async()
 * decides *before* its first await — the promise it hands back, that
 * bad arguments reject rather than throw at the call site, and that it
 * genuinely parks before touching the first element. The atest()
 * entries reach past the suspension: their bodies are async lfuns that
 * await the iteration and then assert on what the callback saw.
 *
 * A functional still cannot await, so each atest() body is a functional
 * that calls one of those lfuns and hands back its promise.
 *
 * Two housekeeping rules keep the suite quiet. Any test that leaves an
 * iteration parked cancels it, so no abandoned frame outlives the
 * cloned test object and rejects on destruction; and any test that
 * produces a rejection observes it through observed(), so it is not
 * reported to the debug log as unhandled.
 */

#include <test.h>

inherit STD_TEST;

// Side-effect accumulator used by functionals inside tests. Each test
// resets it before invoking the function under test. Functionals
// capture no enclosing locals, so a file-global is the sink for "did
// the callback run?" assertions.
private nosave int __counter = 0;
private nosave mixed *__seen = ({});
private nosave mapping __seenMap = ([]);

// The atest() bodies are defined below setup(), so they need prototypes. A
// prototype has to agree with its definition about async — the compiler
// enforces it, because nothing would catch the mismatch at runtime.
private void record(mixed element, int index, mixed *src);
private async void slow_record(mixed element);
private async void check_array_elements();
private async void check_array_callback_args();
private async void check_mapping_callback_args();
private async void check_extra_varargs();
private async void check_awaits_async_callback();
private async void check_resolves_when_done();

/**
 * Marks a deliberately-rejected promise observed, so it is not reported
 * to the debug log as an unhandled rejection.
 *
 * A combinator marks its inputs handled the moment they are attached, and
 * promise_all_settled() never rejects itself. That is what this needs
 * rather than promise_catch(), whose handler is a functional owned by the
 * cloned test object: the drain that would run it happens after the runner
 * has destructed that clone, and calling a function pointer with a
 * destructed owner is itself an error.
 *
 * @param {mixed} p - The promise to observe, or any non-promise value.
 * @returns {mixed} The value it was given, unchanged.
 */
private mixed observed(mixed p) {
  if(promisep(p))
    promise_all_settled(({ p }));

  return p;
}

/**
 * Counts the async frames currently parked inside each_async().
 *
 * @returns {int} Number of suspended each_async() frames.
 */
private int parked_each_async() {
  int count = 0;

  foreach(mapping frame in async_info())
    if(frame["function"] == "each_async")
      count++;

  return count;
}

void setup() {
  describe("each_async (promise contract)", ({
    test("returns a promise for an array", function() {
      ASSERT_EQ(1, promisep(each_async(({}), (: 1 :))));
    }),
    test("returns a promise for a mapping", function() {
      ASSERT_EQ(1, promisep(each_async(([]), (: 1 :))));
    }),
    test("resolves immediately for an empty array", function() {
      ASSERT_EQ(1, resolvedp(each_async(({}), (: 1 :))));
    }),
    test("resolves immediately for an empty mapping", function() {
      ASSERT_EQ(1, resolvedp(each_async(([]), (: 1 :))));
    }),
    test("does not invoke the callback for an empty array",
      function() {
        __counter = 0;
        each_async(({}), (: __counter++ :));

        ASSERT_EQ(0, __counter);
      }),
    test("does not invoke the callback for an empty mapping",
      function() {
        __counter = 0;
        each_async(([]), (: __counter++ :));

        ASSERT_EQ(0, __counter);
      }),
  }));

  describe("each_async (suspension)", ({
    test("a non-empty array leaves the promise pending", function() {
      promise p = each_async(({ 1, 2, 3 }), (: 1 :));
      int pending = pendingp(p);

      promise_cancel(p);

      ASSERT_EQ(1, pending);
    }),
    test("a non-empty mapping leaves the promise pending", function() {
      promise p = each_async(([ "a": 1 ]), (: 1 :));
      int pending = pendingp(p);

      promise_cancel(p);

      ASSERT_EQ(1, pending);
    }),
    test("yields before the first array element", function() {
      promise p;

      __counter = 0;
      p = each_async(({ 1, 2, 3 }), (: __counter++ :));
      promise_cancel(p);

      ASSERT_EQ(0, __counter);
    }),
    test("yields before the first mapping pair", function() {
      promise p;

      __counter = 0;
      p = each_async(([ "a": 1, "b": 2 ]), (: __counter++ :));
      promise_cancel(p);

      ASSERT_EQ(0, __counter);
    }),
    test("parks a frame async_info() reports", function() {
      int before = parked_each_async();
      promise p = each_async(({ 1, 2, 3 }), (: 1 :));
      int during = parked_each_async();

      promise_cancel(p);

      ASSERT_EQ(before + 1, during);
    }),
    test("a parked iteration can be cancelled", function() {
      ASSERT_EQ(1, promise_cancel(each_async(({ 1, 2, 3 }), (: 1 :))));
    }),
  }));

  describe("each_async (errors)", ({
    test("bad arguments reject rather than throw", function() {
      promise p;
      string err = catch(p = each_async("nope", (: 1 :)));

      observed(p);

      ASSERT_EQ(0, err);
    }),
    test("non-array, non-mapping first arg rejects", function() {
      ASSERT_EQ(1, rejectedp(observed(each_async("nope", (: 1 :)))));
    }),
    test("an int first arg rejects", function() {
      ASSERT_EQ(1, rejectedp(observed(each_async(42, (: 1 :)))));
    }),
    test("an undefined first arg rejects", function() {
      ASSERT_EQ(1, rejectedp(observed(each_async(undefined, (: 1 :)))));
    }),
    test("the first-arg rejection names argument 1", function() {
      promise p = observed(each_async(42, (: 1 :)));

      ASSERT_NE(-1, strsrch(promise_result(p), "[Arg #1]"));
    }),
    test("an invalid function rejects", function() {
      ASSERT_EQ(1, rejectedp(observed(each_async(({ 1, 2, 3 }), 0))));
    }),
    test("an undefined function rejects", function() {
      ASSERT_EQ(1,
        rejectedp(observed(each_async(({ 1, 2, 3 }), undefined))));
    }),
    test("the function rejection names argument 2", function() {
      promise p = observed(each_async(({ 1, 2, 3 }), 0));

      ASSERT_NE(-1, strsrch(promise_result(p), "[Arg #2]"));
    }),
    test("a rejected call never parks a frame", function() {
      int before = parked_each_async();

      observed(each_async(42, (: 1 :)));

      ASSERT_EQ(before, parked_each_async());
    }),
    test("a rejection reason is an error reason", function() {
      promise p = observed(each_async(42, (: 1 :)));

      ASSERT_EQ(1, errorp(promise_result(p)));
    }),
  }));

  describe("each_async (post-suspension behaviour)", ({
    atest("invokes the callback for every array element",
      (: check_array_elements() :)),
    atest("passes (element, index, array) to the array callback",
      (: check_array_callback_args() :)),
    atest("passes (key, value, mapping) to the mapping callback",
      (: check_mapping_callback_args() :)),
    atest("forwards extra varargs to the callback",
      (: check_extra_varargs() :)),
    atest("awaits an async callback before the next element",
      (: check_awaits_async_callback() :)),
    atest("resolves once every element has been visited",
      (: check_resolves_when_done() :)),
  }));
}

/**
 * Records one callback invocation for the array-shaped assertions.
 *
 * @param {mixed} element - The element the callback was handed.
 * @param {int} index - Its index.
 * @param {mixed*} src - The source array.
 */
private void record(mixed element, int index, mixed *src) {
  __seen += ({ ({ element, index, sizeof(src) }) });
}

/**
 * Every element is visited, in order.
 */
private async void check_array_elements() {
  __seen = ({});

  await each_async(({ 10, 20, 30 }), (: __seen += ({ $1 }) :));

  ASSERT_EQ(1, same_array(({ 10, 20, 30 }), __seen, 1));
}

/**
 * The array callback is handed (element, index, array).
 */
private async void check_array_callback_args() {
  __seen = ({});

  await each_async(({ "a", "b", "c" }), (: record($1, $2, $3) :));

  // same(), not same_array(): the framework's comparator recurses, while
  // same_array()'s exact mode compares elements with a raw !=, so nested
  // arrays would only ever match by identity.
  ASSERT_EQ(1, same(({
    ({ "a", 0, 3 }), ({ "b", 1, 3 }), ({ "c", 2, 3 })
  }), __seen, 0));
}

/**
 * The mapping callback is handed (key, value, mapping).
 */
private async void check_mapping_callback_args() {
  __seenMap = ([]);
  __counter = 0;

  await each_async(([ "a": 1, "b": 2, "c": 3 ]),
    (: __seenMap[$1] = $2, __counter += sizeof($3) :));

  ASSERT_EQ(([ "a": 1, "b": 2, "c": 3 ]), __seenMap);
  // Called three times, each seeing a three-element mapping.
  ASSERT_EQ(9, __counter);
}

/**
 * Extra arguments are forwarded to the callback from $4 on, for both
 * collection shapes.
 */
private async void check_extra_varargs() {
  __seen = ({});

  await each_async(({ 1, 2, 3 }), (: __seen += ({ $1 * $4 }) :), 10);

  ASSERT_EQ(1, same_array(({ 10, 20, 30 }), __seen, 1));

  __seen = ({});

  await each_async(([ "a": 2, "b": 3 ]), (: __seen += ({ $2 * $4 }) :), 5);

  // Bare ASSERT_EQ on purpose: it compares arrays loosely, and mapping
  // traversal order is a hash-table detail rather than a promise, so
  // ({ 15, 10 }) has to pass here too.
  ASSERT_EQ(({ 10, 15 }), __seen);
}

/**
 * Marks the start of a callback, suspends, then marks its end. If
 * each_async() awaits the callback, the marks pair up; if it did not,
 * every start would land before the first end.
 *
 * @param {mixed} element - The element being processed.
 */
private async void slow_record(mixed element) {
  __seen += ({ "start" + element });

  await async_yield();

  __seen += ({ "end" + element });
}

/**
 * An async callback finishes before the next element begins.
 */
private async void check_awaits_async_callback() {
  __seen = ({});

  await each_async(({ 1, 2 }), (: slow_record($1) :));

  ASSERT_EQ(1, same_array(({ "start1", "end1", "start2", "end2" }),
    __seen, 1));
}

/**
 * The promise resolves — rather than merely settling — once the whole
 * collection has been walked.
 */
private async void check_resolves_when_done() {
  promise p;

  __counter = 0;
  p = each_async(({ 1, 2, 3 }), (: __counter++ :));

  await p;

  ASSERT_EQ(1, resolvedp(p));
  ASSERT_EQ(3, __counter);
}
