/**
 * @file /std/test/test.lpc
 * Base for individual test files. A test file inherits this,
 * registers suites in setup() via describe()/test(), and is
 * cloned and invoked by a STD_TEST_RUNNER.
 */

#include <test.h>

inherit STD_OBJECT;

// Forward declare functions
varargs int same(mixed x, mixed y, int loose);
void _assert(int condition, string where);
void _assert_eq(mixed expected, mixed actual, string where);
void _assert_ne(mixed expected, mixed actual, string where);

void mudlib_setup() {
  // master()->clear_last_error();
}

private nosave mixed *test_functions = ({});

/**
 * Compare two values for equality.
 *
 * @param {mixed} x The first value to compare
 * @param {mixed} y The second value to compare
 * @param {int} [loose=1] If true, allow arrays to be loosely compared,
 *                        rather than requiring positional matches.
 * @returns {int} 1 if the values are equal, 0 otherwise
 */
varargs int same(mixed x, mixed y, int loose) {
  loose = nullp(loose) ? 1 : loose;

  // Allow comparing array with buffer
  if(!(typeof(x) == T_ARRAY && typeof(y) == T_BUFFER || typeof(y) == T_ARRAY && typeof(x) == T_BUFFER))
  if(typeof(x) != typeof(y))
    return 0;
  switch(typeof(x)) {
    case T_INT:
      // undefined values are 0, but still test as undefined
      if(nullp(x))
        return nullp(y);
      // fallthrough, because it was a legit 0
    case T_UNDEFINED:
    case T_STRING:
    case T_OBJECT:
    case T_FLOAT:
    case T_FUNCTION:
    case T_PROMISE:
      return x == y;
    case T_MAPPING: {
      mixed *other_keys;

      if(x == y) return 1; // speed up this case
      if(sizeof(x) != sizeof(y)) return 0;

      // Pair each key with its own value. Comparing keys() and values() as
      // two loose arrays lets a mapping match one that pairs the same keys
      // and values up differently.
      other_keys = keys(y);

      foreach(mixed key, mixed value in x) {
        if(member_array(key, other_keys) == -1)
          return 0;

        if(!same(value, y[key], loose))
          return 0;
      }

      return 1;
    }
    case T_BUFFER:
    case T_ARRAY:
      if(sizeof(x) != sizeof(y))
        return 0;

      // Recurse rather than reaching for member_array(), which compares
      // nested arrays and mappings by identity and so never matches an
      // equal-but-separate structure.
      if(loose) {
        // Each candidate satisfies at most one element. Without consuming the
        // match, ({ 1, 1 }) and ({ 1, 2 }) compare equal — both 1s pair off
        // against the same candidate — and unequal multisets pass ASSERT_EQ.
        int *taken = allocate(sizeof(y));

        foreach(mixed element in x) {
          // Explicitly zeroed: a local is a frame slot, so a bare `int found;`
          // inside a loop body keeps whatever the previous iteration left in
          // it rather than starting over at 0.
          int found = 0;

          for(int i = 0; i < sizeof(y); i++) {
            if(taken[i])
              continue;

            if(same(element, y[i], loose)) {
              taken[i] = 1;
              found = 1;
              break;
            }
          }

          if(!found)
            return 0;
        }

        return 1;
      }

      for(int i = 0; i < sizeof(x); i++)
        if(!same(x[i], y[i], loose))
          return 0;

      return 1;
    case T_CLASS:
      error("Not implemented.");
  }

  return 0;
}

void _assert(int condition, string where) {
  if(!condition)
    throw(sprintf("Assertion Failed: %s", where));
}

void _assert_eq(mixed expected, mixed actual, string where) {
  _assert(
    same(expected, actual),
    sprintf("%s\nExpected: %O\nGot: %O", where, expected, actual)
  );
}

void _assert_ne(mixed expected, mixed actual, string where) {
  _assert(
    !same(expected, actual),
    sprintf("%s\nExpected: %O\nGot: %O", where, expected, actual)
  );
}

/**
 * Register a suite of tests.
 *
 * @param {string} description Suite description.
 * @param {mixed *} tests Array of test entries built by test().
 * @returns {object} this_object() for chaining.
 */
object describe(string description, mixed *tests) {
  test_functions += ({({ description, tests })});

  return this_object();
}

/**
 * Build a single test entry. The returned array is meant to be placed in the
 * tests array passed to describe().
 *
 * @param {string} description Test description.
 * @param {function} test The test function. May call ASSERT_EQ etc.
 * @param {mixed} args Optional extra args passed to the test function.
 */
varargs mixed *test(string description, function test, mixed *args...) {
  args = args || ({});

  return ({description, function(function f, mixed *fn_args) {
    string e = catch{
      if(sizeof(fn_args))
        (*f)(fn_args...);
      else
        (*f)();
    };

    if(e)
      throw(e);

    return 1;
  }, test, args...});
}

/**
 * Build a pending test entry — registered in the suite, listed in the
 * summary, but never executed. Use when you've identified a buggy
 * boundary, an unimplemented behaviour, or anything you want surfaced
 * without blocking the suite.
 *
 * @param {string} description Test description.
 * @param {string} [reason] Optional explanation for why it's pending.
 */
varargs mixed *pending(string description, string reason) {
  return ({ description, "pending", reason || "" });
}

/**
 * Build a test entry whose body returns a promise, to be awaited before the
 * result is recorded. Use it for behaviour that only exists once a suspension
 * has resumed; test() cannot reach that, because a functional body may not
 * await.
 *
 * The body is an ordinary functional, so it cannot await either — what it does
 * is call an async lfun on the test object and hand back its promise, and the
 * assertions live in that lfun after its own awaits:
 *
 *   atest("visits every element", (: check_visits_every_element() :)),
 *
 * A failed assertion throws, which rejects the lfun's promise, which is raised
 * again at the runner's await and recorded exactly like a sync failure. A body
 * that returns a plain value is treated as an ordinary passing test.
 *
 * @param {string} description Test description.
 * @param {function} test Functional returning the promise to await.
 * @param {mixed} args Optional extra args passed to the functional.
 * @returns {mixed *} A test entry for the array passed to describe().
 */
varargs mixed *atest(string description, function test, mixed *args...) {
  args = args || ({});

  return ({ description, "async", test, args... });
}

/**
 * Seconds an atest() body is given to settle. Override in a test file whose
 * async work legitimately takes longer.
 *
 * @returns {int} The ceiling, in seconds.
 */
protected int async_timeout() {
  return TEST_ASYNC_TIMEOUT;
}

/**
 * Awaits a promise under a ceiling, so a promise that never settles fails
 * instead of parking the frame for the life of the driver. The runner puts
 * every atest() body through this, and an async test lfun can use it directly
 * on any individual await it does not trust:
 *
 *   mixed rows = await with_timeout(SOME_D->fetch(), 3);
 *
 * The ceiling itself is with_deadline()'s; this only supplies the test
 * framework's default. A non-promise is returned as-is, so wrapping something
 * that turns out to be synchronous costs nothing and arms no timer.
 *
 * @param {mixed} p - The promise to await, or any plain value.
 * @param {int} [secs] - Ceiling in seconds; defaults to async_timeout().
 * @returns {mixed} What p fulfilled with, or p itself if it was not a promise.
 * @throws ASYNC_ERR_TIMEOUT if the ceiling elapses first, and whatever p
 *  rejected with otherwise.
 */
protected async varargs mixed with_timeout(mixed p, int secs) {
  return await with_deadline(p, to_float(secs || async_timeout()));
}

/**
 * Invokes an atest() body and waits for whatever it hands back, under the
 * file's timeout. Throws on failure so the caller records it the same way it
 * records a sync test throwing.
 *
 * @param {function} fun - The test body.
 * @param {mixed *} args - Extra arguments for the body.
 */
private async void run_async_test(function fun, mixed *args) {
  // Evaluated before any timer is armed, so a body that throws synchronously
  // cannot leave one parked.
  mixed result = sizeof(args) ? evaluate(fun, args...) : evaluate(fun);
  mixed err;

  if(!promisep(result))
    return;

  err = acatch {
    await with_timeout(result, async_timeout());
  };

  if(!err)
    return;

  if(err == ASYNC_ERR_TIMEOUT)
    throw(sprintf("Timed out after %d seconds waiting for the test to settle.",
      async_timeout()));

  // Asked to give up rather than failed. The status is the authoritative
  // test: a body can forge PROMISE_REASON_CANCELLED with throw(), and a
  // cancellation arriving at *this* frame's await rather than the body's
  // carries the same reason while leaving the body pending.
  if(cancelledp(result))
    throw("The test body was cancelled before it settled.");

  throw(err);
}

/**
 * Run all registered suites and return aggregate results. Resets the suite
 * list so a subsequent run() starts fresh (relevant if the same instance is
 * reused; runners typically clone instead).
 *
 * Async, because an atest() entry is awaited before its result is recorded.
 * Every call site therefore receives a promise, including a suite with no
 * atest() in it — see the runner, which awaits this.
 *
 * Cancelling the returned promise stops the file after the test it is running.
 * The request is caught rather than left to settle this promise, so the tests
 * already recorded are still handed back: a stopped file reports what it got
 * through, and the runner decides what to do about the rest.
 *
 * @returns {mixed *} ({ passed, failed, failures, pendings }) where failures
 *                   is an array of ({ suite, test, error }) and pendings is
 *                   an array of ({ suite, test, reason }).
 */
async mixed *run() {
  mixed *failures = ({});
  mixed *pendings = ({});
  int passed = 0, failed = 0, stopped = 0;

  foreach(mixed *suite in test_functions) {
    string suite_description = suite[0];
    mixed *tests = suite[1];

    foreach(mixed *test in tests) {
      string test_description = test[0];
      mixed e;

      // pending: ({ description, "pending", reason })
      if(stringp(test[1]) && test[1] == "pending") {
        pendings += ({({ suite_description, test_description, test[2] })});
        continue;
      }

      // async: ({ description, "async", body, args... }). acatch rather than
      // catch, because await is illegal inside catch().
      if(stringp(test[1]) && test[1] == "async") {
        mixed *args = sizeof(test) > 3 ? test[3..] : ({});

        e = acatch {
          await run_async_test(test[2], args);
        };

        // Asked to stop, not failed. The test body run_async_test() was
        // waiting on is left alone: it is bounded by the file's own timeout,
        // and the runner destructs this clone straight after, which abandons
        // the frame anyway.
        if(e == PROMISE_REASON_CANCELLED) {
          stopped = 1;

          break;
        }

        if(e) {
          failed++;
          failures += ({({ suite_description, test_description,
            stringp(e) ? e : sprintf("%O", e) })});
        } else
          passed++;

        continue;
      }

      e = catch((*test[1])(test[2], sizeof(test) > 3 ? test[3..] : ({}))) || 1;

      if(stringp(e)) {
        failed++;
        failures += ({({ suite_description, test_description, e })});
      } else {
        passed++;
      }
    }

    if(stopped)
      break;
  }

  test_functions = ({});

  return ({ passed, failed, failures, pendings });
}
