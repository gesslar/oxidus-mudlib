// /std/ext/gmcp.c
// Module inherited by living objects to handle GMCP
//
// Created:     2024/02/22: Gesslar
// Last Change: 2024/02/22: Gesslar
//
// 2024/02/22: Gesslar - Created

#include <daemons.h>
#include <classes.h>

#include "/std/living/include/env.h"

inherit CLASS_GMCP;

// Functions
public int gmcp_enabled();
private mixed gmcp_stringify(mixed data);
varargs promise gmcp_await(string name, float seconds);
private async mixed bounded_gmcp_wait(string name, promise p, float seconds);

// Functions from other objects
varargs void _log(mixed args...);

private nosave mapping gmcp_data = ([ ]);

// Messages this connection is currently waiting on, keyed by the full dotted
// package name. The apply below resolves and removes an entry as the message
// arrives; the removal is also what tells a pending deadline to bow out.
private nosave mapping gmcp_waiting = ([ ]);

/**
 * Waits for the next GMCP message of a given name from this client.
 *
 * One outstanding wait per package name -- a second call replaces the first,
 * which is then never settled by anything but its own deadline.
 *
 * The promise handed back is always an async function's, including in the
 * indefinite case, so a caller racing this against something else can release
 * it with promise_cancel(). That is not a detail a caller could work out for
 * itself: cancelling a promise that is not a body's is a hard error, and
 * nothing can be asked of a promise to tell the two apart. Returning the
 * mailbox promise directly for one of the two windows would make the safety of
 * a cancel depend on the argument.
 *
 * @param {string} name - Full dotted package name, e.g. "Core.Supports.Set".
 * @param {float} [seconds] - How long to wait before giving up. Non-positive
 *  waits indefinitely, which only makes sense for something the client is
 *  certain to send, or for something being raced against another arm.
 * @returns {promise} Fulfilled with the message payload, or rejected once the
 *  wait has gone unanswered for `seconds`. This function is not async — it
 *  opens the mailbox and hands the waiting body's promise back — so the tag
 *  names the promise, not the payload.
 */
varargs promise gmcp_await(string name, float seconds) {
  promise p = promise_create();

  gmcp_waiting[name] = p;

  return bounded_gmcp_wait(name, p, seconds);
}

/**
 * Awaits one GMCP message under its window and retires the mailbox entry on
 * every path that did not deliver one.
 *
 * with_deadline() decides when to stop waiting; clearing the entry is this
 * module's own business. It is cleared only if it is still the one this wait
 * opened, because a second gmcp_await() for the same name replaces the first
 * and a late loser must not delete a mailbox that now belongs to someone
 * else. On the delivery path the apply has already cleared it.
 *
 * A caller that cancels this wait -- racing it against something else and
 * releasing the loser, as the login flow does -- gets the cancellation
 * forwarded to the with_deadline() body below. Cancellation does not
 * propagate on its own: that body is first-class and may have other awaiters,
 * so nobody but its holder can decide to stop it, and left alone it would
 * hold its timer for the rest of the window.
 *
 * @param {string} name - The package name being waited on.
 * @param {promise} p - The mailbox promise the apply resolves on arrival.
 * @param {float} seconds - The window to wait out before giving up.
 * @returns {mixed} The message payload.
 * @throws A message naming the package if the window elapses first, and
 *  whatever the wait rejected with otherwise.
 */
private async mixed bounded_gmcp_wait(string name, promise p, float seconds) {
  promise wait = with_deadline(p, seconds);
  mixed result;
  mixed err = acatch {
    result = await wait;
  };

  if(!err)
    return result;

  if(gmcp_waiting[name] == p)
    map_delete(gmcp_waiting, name);

  if(err == PROMISE_REASON_CANCELLED)
    promise_cancel(wait);

  if(err == ASYNC_ERR_TIMEOUT)
    throw(`No ${name} from client after ${seconds} seconds.`);

  throw(err);
}

// This apply receives the GMCP messages from the client. We parse out the
// information into what package, subpackage, command, and payload. We then
// call the appropriate module to handle the GMCP message.
//
// We do not check if the player has GMCP enabled here. We assume that the
// client will not send GMCP messages if it is not enabled, and, we want to
// ensure that we still get Core.Hello and Core.Supports if available during
// login, since they are most likely only sent at that time. If a module does
// respond to the client, it should route its message through the GMCP_D which
// will check if the player has GMCP enabled and behave accordingly.
void gmcp(string message) {
    class ClassGMCP gmcp;
    string err;
    string gmcp_module;
    object ob;

    gmcp = GMCP_D->convert_message(message);

    if(gmcp == null)
        return;

    if(gmcp.package == null || gmcp.module == null)
        return;


    // Wake anything awaiting this message. Done before the handler lookup
    // below, which returns early when a package has no handler file -- a
    // message we are only waiting on does not need one. The waiter does not
    // resume here: promise deliveries are drained after this call returns,
    // so the handler dispatched below still runs first.
    if(gmcp_waiting[gmcp.name]) {
        promise waiting = gmcp_waiting[gmcp.name];

        map_delete(gmcp_waiting, gmcp.name);
        promise_resolve(waiting, gmcp.payload);
    }

    gmcp_module = DIR_STD_HANDLERS "gmcp/" + gmcp.package + ".lpc";
    if(!file_exists(gmcp_module)) {
        log_file("system/gmcp", "[%s] Module %s not found [%O]",
            ldatetime(),
            gmcp_module,
            previous_object() || this_object()
        );
        return;
    }

    if(err = catch(ob = load_object(gmcp_module)))
        return;

    if(gmcp.submodule)
        call_other(ob, gmcp.module, gmcp.submodule, gmcp.payload);
    else
        call_other(ob, gmcp.module, gmcp.payload);
}

// This function sends a GMCP message to the client. It will only send the
// message if the player has GMCP enabled. If the player does not have GMCP
// enabled, the message will be ignored.
varargs void do_gmcp(string package, mixed data) {
    string message;

    if(!get_config(__RC_ENABLE_GMCP__))
        return;

    if(!gmcp_enabled())
        return;

    if(data)
        data = json_encode(gmcp_stringify(data));
    else
        data = "";

    message = trim(sprintf("%s %s", package, data));

    send_gmcp(message);
}

// This function sanitises the data to be sent to the client. It will convert
// the data to a string if it is not already a string. For mappings and arrays,
// it will convert the data to a string representation of the data. GMCP should
// always send keys and values as strings, so we convert them here.
mixed gmcp_stringify(mixed data) {
  switch(typeof(data)) {
    case T_STRING:
      return data;
    case T_INT:
      return sprintf("%d", data);
    case T_ARRAY: {
      mixed *result;

      result = map(data, (: gmcp_stringify :));

      return result;
    }
    case T_OBJECT:
      return "";
    case T_MAPPING: {
      mapping result = ([ ]);
      mixed key, value;

      foreach(key, value in data) {
        result[gmcp_stringify(key)] = gmcp_stringify(value);
      }

      return result;
    }
    case T_FUNCTION:
      return "";
    case T_FLOAT:
      return sprintf("%f", data);
    case T_BUFFER:
      return "";
    case T_CLASS:
      return "";
    default:
      return "";
  }
}

void clear_gmcp_data() {
  gmcp_data = ([ ]);
}

void set_gmcp_client(mapping data) {
  gmcp_data["client"] = data;
}

mapping query_gmcp_client() {
  return copy(gmcp_data["client"]);
}

void set_gmcp_supports(mapping data) {
  gmcp_data["supports"] = data;
}

mapping query_gmcp_supports() {
  return copy(gmcp_data["supports"]);
}

// Function to determine if a specific package (and optionally module/
// submodule) is supported
int query_gmcp_supported(string fullname) {
  string package, module, submodule;
  mapping supports = query_gmcp_supports();
  class ClassGMCP gmcp;

  gmcp = GMCP_D->convert_message(fullname);

  // Check if the package is supported
  if(!supports[package])
    return 0; // Package not found

  // If a module is specified, check for its support
  if(module && supports[package]["modules"]) {
    if(!supports[package]["modules"][module])
      return 0; // Module not found

    // If a submodule is specified, check for its support
    if(submodule && supports[package]["modules"][module]["submodules"]) {
      if(!supports[package]["modules"][module]["submodules"][submodule])
        return 0; // Submodule not found
    } else if(submodule) {
      // Submodule specified but no submodules are supported under the module
      return 0;
    }
  } else if(module) {
    // Module specified but no modules are supported under the package
    return 0;
  }

  // If we've reached this point, the specified package (and optionally module/
  // submodule) is supported
  return 1;
}


public int gmcp_enabled() {
  if(!has_gmcp(this_object()))
    return 0;

  // @lpc-expect-error: comparison is made at runtime after being inherited
  if(base_name() == LOGIN_OB)
    return 1;

  return query_pref("gmcp") != "off";
}
