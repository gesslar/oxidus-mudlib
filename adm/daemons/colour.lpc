});

mixed *base_colours() {
  return copy(_base_colours);
}

/**
 * Converts an ANSI 256 colour code to the nearest 3-digit hex shorthand.
 *
 * A shorthand digit expands by repetition, so the sixteen reachable values
 * per channel are 17 apart. The xterm cube's levels do not sit on those
 * boundaries, so this is a lossy narrowing by construction; it picks the
 * nearest digit rather than truncating, which would bias every channel
 * downward — level 95 would render as 5 (85) when 6 (102) is closer.
 *
 * @param {int} ansi - ANSI 256 colour code (0-255)
 * @returns {string} 3-digit hex colour code
 */
string ansi256_to_3hex(int ansi) {
  int *rgb = colour_to_rgb(ansi);

  return sprintf("%X%X%X", (rgb[0] + 8) / 17, (rgb[1] + 8) / 17,
    (rgb[2] + 8) / 17);
}

int get_luminance(int *rgb) {
  assert_arg(uniformp(rgb, T_INT), 1, "Invalid value.");
  assert_arg(every(rgb, (: !nullp($1) && clamped($1, 0, 255) :)), 1, "Invalid value.");

  return to_int(round(0.2126 * rgb[0] + 0.7152 * rgb[1] + 0.0722 * rgb[2]));
}

/**
 * Lightens a colour until it clears the minimum luminance.
 *
 * The luminance weights total 1.0, so adding the same amount to every
 * channel raises the luminance by exactly that amount. A channel already at
 * 255 contributes less than its share, so the lift repeats until the colour
 * clears the floor or no channel can be raised any further.
 *
 * @param {int*} rgb - The colour to lighten.
 * @returns {int*} The lightened colour.
 */
private int *lighten_to_minimum(int *rgb) {
  int lum = get_luminance(rgb);

  while(lum < minimum_luminance) {
    int lift = to_int(ceil(to_float(minimum_luminance - lum)));
    int *lifted = ({
      clamp(rgb[0] + lift, 0, 255),
      clamp(rgb[1] + lift, 0, 255),
      clamp(rgb[2] + lift, 0, 255),
    });

    // Fully saturated in every channel that could still be raised; this is
    // as light as the colour gets without shifting its hue.
    if(same_array(lifted, rgb, 1))
      break;

    rgb = lifted;
    lum = get_luminance(rgb);
  }

  return rgb;
}

/**
 * Pick a random RGB triple in the bright range. Each channel is
 * 80-255, so the result avoids the dark end of the spectrum and
 * stays legible on most terminals without needing the dark-colour
 * fix-up pass.
 *
 * @returns {int*} A 3-element array of { r, g, b }, each in 80-255.
 */
int *random_bright_rgb() {
  return ({
    80 + random(176),
    80 + random(176),
    80 + random(176),
  });
}

/**
 * Pick a random bright colour and return its hex form. Convenience
 * wrapper over random_bright_rgb() + rgb_to_hex().
 *
 * @returns {string} A 6-character hex code (no leading "#").
 */
string random_bright_hex() {
  int *rgb = random_bright_rgb();

  return rgb_to_hex(rgb);
}

/**
 * Lightens a colour that falls below the mud's minimum luminance.
 *
 * A colour already at or above the floor is returned untouched; anything
 * darker is lightened until it clears the floor.
 *
 * @param {string} hex - The colour code to potentially lighten
 * @returns {string} The lightened colour code, or the original if it was
 *                   already light enough. Answered in whichever form the
 *                   caller asked in — bare, `{{fg}}`, or `{^bg^}`.
 */
string substitute_too_dark(string hex) {
  int *rgb = hex_to_rgb(hex);
  string lightened;

  if(get_luminance(rgb) >= minimum_luminance)
    return hex;

  lightened = rgb_to_hex(lighten_to_minimum(rgb));

  if(pcre_match(hex, "^\\{\\{"))
    return sprintf("{{%s}}", lightened);

  if(pcre_match(hex, "^\\{\\^"))
    return sprintf("{^%s^}", lightened);

  return lightened;
}

private void normalize_hex(string ref hex) {
  string given = hex;
  int r, g, b;
  string *match;

  hex = all_caps(hex);

  match = pcre_extract(hex, TRUE_COLOUR_REGEX);

  if(!sizeof(match))
    match = pcre_extract(hex, BG_TRUE_COLOUR_REGEX);

  // Undelimited, so either a bare hex code the caller typed straight in —
  // 3 or 6 digits, optional leading "#" — or something unreadable.
  if(!sizeof(match)) {
    assert_arg(pcre_match(hex, HEX_CHECK), 1, `Invalid hex colour: "${given}"`);

    match = ({ hex[0..0] == "#" ? hex[1..] : hex });
  }

  hex = match[0];

  // We good!
  if(strlen(hex) == 6)
    return;

  sscanf(hex[0..0], "%x", r);
  sscanf(hex[1..1], "%x", g);
  sscanf(hex[2..2], "%x", b);

  r *= 17;
  g *= 17;
  b *= 17;

  hex = sprintf("%02x%02x%02x", r, g, b);
}

/**
 * Converts a colour code to its greyscale equivalent.
 *
 * Converts any colour to its closest matching greyscale value
 * in the range 232-255.
 *
 * @param {int} colour_code - Original colour code (0-255)
 * @returns {int} Equivalent greyscale colour code (232-255)
 */
int colour_to_greyscale(int colour_code) {
  float normalized;
  int greyscale_code;

  normalized = colour_code / 255.0;
  greyscale_code = to_int(normalized * 23) + 232;

  // Return the corresponding greyscale colour code
  return greyscale_code;
}

/**
 * Applies body-specific colour preferences to message text.
 *
 * Processes text according to the body's colour preferences and message type.
 * Handles special cases like combat messages differently.
 *
 * @param {object STD_BODY} body - The body object with colour preferences
 * @param {string} text - Text to process
 * @param {int} message_type - Type of message (NO_COLOUR, MSG_COMBAT_HIT, etc)
 * @returns {string} Text with applied colour preferences
 */
public string bod_colour_replace(object body, string text, int message_type) {
  string pref, colour;

  if(!objectp(body) || !stringp(text) || !strlen(text) || !message_type)
    return text;

  if(message_type & NO_COLOUR)
    return text;
  else if(message_type & MSG_COMBAT_HIT)
    pref = body->query_pref("combat_hit_colour");
  else if(message_type & MSG_COMBAT_MISS)
    pref = body->query_pref("combat_miss_colour");
  else
    return text;

  if(!stringp(pref) || !strlen(pref))
    return text;

  colour = sprintf("{{%s}}", pref);

  if(pcre_match(colour, TRUE_COLOUR_REGEX))
    text = sprintf("%s%s{{res}}", colour, text);

  return text;
}

/**
 * Converts RGB values to the nearest 256-colour code.
 *
 * Searches the whole space — system colours, the 6x6x6 cube and the
 * greyscale ramp — for the code whose own RGB sits closest, so a colour
 * that has an exact match always maps back to itself.
 *
 * @param {int} r - Red component (0-255)
 * @param {int} g - Green component (0-255)
 * @param {int} b - Blue component (0-255)
 * @returns {int} Best matching 256-colour code
 * @errors If any RGB value is outside the valid range
 */
public int rgb_to_colour(int r, int g, int b) {
  int best;
  int best_distance = -1;

  if(r < 0 || r > 255 || g < 0 || g > 255 || b < 0 || b > 255)
    error("Invalid RGB values: " + r + ", " + g + ", " + b);

  for(int code = 0; code < 256; code++) {
    int *rgb = colour_to_rgb(code);
    int distance = (r - rgb[0]) * (r - rgb[0]) +
                   (g - rgb[1]) * (g - rgb[1]) +
                   (b - rgb[2]) * (b - rgb[2]);

    // Ties go to the higher code: 0-15 are whatever the player's terminal
    // themes them to, while 16-255 are fixed.
    if(best_distance < 0 || distance <= best_distance) {
      best = code;
      best_distance = distance;
    }
  }

  return best;
}

/**
 * Converts RGB values to a 256-color code.
 *
 * @param {int} colour_code - Array containing RGB values [r, g, b]
 * @returns {int*} The corresponding 256-color code
 */
int *colour_to_rgb(int colour_code) {
  int r, g, b;

  if(colour_code < 16) { // ANSI basic colors
    return ansi_rgb[colour_code]; // Assuming you have a predefined array like before
  } else if(clamped(colour_code, 16, 231)) { // 6x6x6 colour cube (216 colours)
    colour_code -= 16;
    r = colour_code / 36;
    g = (colour_code / 6) % 6;
    b = colour_code % 6;

    // The xterm-256 cube is not evenly spaced: level 0 is 0, and levels 1-5
    // are 55 + n * 40, giving 0, 95, 135, 175, 215, 255. Deriving it as
    // n * 51 agrees only at the two ends, so every middle level named an RGB
    // the terminal does not render — and rgb_to_colour(), which searches
    // these as its candidates, answered with the wrong code as a result.
    r = r ? 55 + r * 40 : 0;
    g = g ? 55 + g * 40 : 0;
    b = b ? 55 + b * 40 : 0;
  } else { // 24 greyscale shades (232-255)
    r = g = b = 8 + (colour_code - 232) * 10; // Start at 8, increase by 10
  }

  return ({ r, g, b });
}

/**
 * Converts RGB values to a hexadecimal color string.
 *
 * @param {int*} rgb - Array containing RGB values [r, g, b]
 * @returns {string} Hexadecimal color string in format "RRGGBB"
 */
varargs string rgb_to_hex(int *rgb) {
  return sprintf("%02X%02X%02X", rgb[0], rgb[1], rgb[2]);
}

/**
 * Converts an RGB color array to a color sequence string.
 *
 * @param {int*} rgb - Array of 3 integers representing RGB values
 * @param {int} mode - 0 for foreground, 1 for background
 * @returns {string} ANSI escape sequence for the color
 */
public string rgb_to_sequence(int *rgb, int mode) {
  int r, g, b;
  int bg = !!mode ? 48 : 38;

  r = rgb[0];
  g = rgb[1];
  b = rgb[2];

  return sprintf("\e[%d;2;%d;%d;%dm", bg, r, g, b);
}

int *hex_to_rgb(string hex) {
  int r, g, b;

  normalize_hex(ref hex);

  sscanf(hex[0..1], "%x", r);
  sscanf(hex[2..3], "%x", g);
  sscanf(hex[4..5], "%x", b);

  return ({r, g, b});
}

/**
 * Converts a hex color string to an ANSI escape sequence.
 *
 * @param {string} hex - Hex color code (3 or 6 digits)
 * @param {int} mode - 0 for foreground, 1 for background
 * @returns {string} ANSI escape sequence for the color
 */
varargs string hex_to_sequence(string hex, int mode) {
  int *rgb;

  rgb = hex_to_rgb(hex);

  return rgb_to_sequence(rgb, mode);
}

/**
 * Performs resynchronization of the colour system.
 *
 * @returns {void}
 */
void resync() {
  cache_attributes();
  cache256();
}
